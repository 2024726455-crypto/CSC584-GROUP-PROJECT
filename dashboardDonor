<!DOCTYPE html>
<html lang="en">
<head>
    <title>Donor Dashboard</title>
</head>
<body>
    <h2>Welcome, Donor!</h2>
    <p>Thank you for your generosity! Total Donated: <strong>50 meals/items</strong></p>
    <a href="index.html">Logout</a>
    <hr>

    <h3>Log New Donation (Create)</h3>
    <form>
        <label>Item Name:</label><br>
        <input type="text" required><br><br>
        <label>Quantity:</label><br>
        <input type="number" required><br><br>
        <label>Expiry Date:</label><br>
        <input type="date" required><br><br>
        <button type="submit">Submit Donation</button>
    </form>

    <h3>Donation History (Read)</h3>
    <table border="1">
        <tr>
            <th>Item</th><th>Quantity</th><th>Date</th>
        </tr>
        <tr>
            <td>Canned Sardines</td><td>20</td><td>2026-05-15</td>
        </tr>
    </table>
</body>
</html>
